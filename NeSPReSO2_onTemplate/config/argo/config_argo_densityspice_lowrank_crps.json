{
    "name": "NeSPReSO2_ARGO_GoM_densityspice_lowrank_crps",
    "n_gpu": 1,
    "seed": 42,
    "arch": {
        "type": "PatchConvMLP",
        "args": {
            "input_dim": 9,
            "output_dim": 32,
            "dropout_prob": 0.2,
            "d_model": 128,
            "head_layers": [
                1024,
                1024
            ],
            "patch_shape": null,
            "n_enc": 6,
            "n_sat": 3,
            "probabilistic": true,
            "n_quantiles": 0,
            "sigma_min": 0.001
        }
    },
    "input_params": {
        "timecos": true,
        "timesin": true,
        "latcos": true,
        "latsin": true,
        "loncos": true,
        "lonsin": true,
        "sss": true,
        "sst": true,
        "ssh": true,
        "sat": true
    },
    "io": {
        "dataset_tag": "argo_v2",
        "cache_dir": "../data/cache",
        "spatial_pad": 0,
        "temporal_pad": 0,
        "v2_pickle": "/unity/g2/jmiranda/SubsurfaceFields/GEM_SubsurfaceFields/config_dataset_full.pkl",
        "v2_src": "/unity/g2/jmiranda/v2-nespreso/src",
        "v2_reload": false,
        "refit_pca": true,
        "representation": "density_spice",
        "n_ctrl": 64,
        "lowrank_target": "sigma0"
    },
    "outputs": {
        "density_ctrl": 16,
        "spice": 16
    },
    "loss_scales": {
        "lambda_rho": 0.05,
        "lambda_tau": 1.0
    },
    "augment": {
        "input_noise_alpha": 0.0
    },
    "density": {
        "enabled": false,
        "checkpoint": "",
        "stats_path": "",
        "stab_weight": 0.0,
        "smooth_weight": 0.0
    },
    "data_loader": {
        "type": "NeSPReSODataLoader",
        "args": {
            "cache_path": "",
            "batch_size": 512,
            "shuffle": true,
            "split_mode": "chronological",
            "train_frac": 0.7,
            "val_frac": 0.15,
            "test_frac": 0.15,
            "split": "train",
            "num_workers": 0,
            "pin_memory": false,
            "use_error_channels": false
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },
    "loss": "combined_pca_loss",
    "loss_config": {
        "mode": "density_spice",
        "prob_mode": "crps",
        "freeze_sigma": false,
        "nll_beta": 0.5,
        "sigma_min": 0.001
    },
    "metrics": [],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 100000,
            "gamma": 1.0
        }
    },
    "trainer": {
        "epochs": 60,
        "save_dir": "saved/argo_densityspice_lowrank_crps/",
        "save_period": 10,
        "log_interval": 50,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 20,
        "tensorboard": false,
        "grad_clip_norm": 5.0,
        "density_weight_scale": 0.01
    }
}
