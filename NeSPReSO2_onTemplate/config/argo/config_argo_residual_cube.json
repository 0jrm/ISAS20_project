{
    "name": "NeSPReSO2_ARGO_GoM_residual_cube",
    "n_gpu": 1,
    "seed": 42,
    "arch": {
        "type": "PointAnchoredResidual",
        "args": {
            "input_dim": 41,
            "output_dim": 32,
            "base_dim": 9,
            "feat_dim": 32,
            "feat_offset": 9,
            "d_model": 128,
            "head_hidden": [128, 128],
            "dropout_prob": 0.1,
            "gate_per_pc": true,
            "freeze_base": true,
            "warmstart_ckpt": "saved/models/NeSPReSO2_ARGO_GoM/point_cube/model_best.pth",
            "n_enc": 6,
            "n_sat": 3,
            "base_head_layers": [1024, 1024]
        }
    },
    "features": {
        "spec_version": 1,
        "scalars": [
            "timecos", "timesin", "latcos", "latsin", "loncos", "lonsin",
            "basin_sss", "basin_sst", "basin_ssh", "bathy_depth"
        ],
        "point_backbone_inputs": [
            "sss.value@local", "sst.value@local", "ssh.value@local"
        ],
        "operators": [
            {"op": "value", "channels": ["sst", "sss", "ssh"], "scales": ["local"]},
            {"op": "grad", "channels": ["sst", "sss", "ssh"], "scales": ["local", "1.0deg"]},
            {"op": "laplacian", "channels": ["ssh"], "scales": ["1.0deg"]},
            {"op": "tendency", "channels": ["sst", "ssh"], "window_days": 7},
            {"op": "geo_uv", "channels": ["ssh"], "scales": ["local", "1.0deg"]}
        ]
    },
    "io": {
        "dataset_tag": "argo_cube",
        "cube_path": "data/cube/gom_cube.zarr",
        "cache_dir": "data/cache",
        "spatial_pad": 2,
        "temporal_pad": 6,
        "v2_pickle": "/unity/g2/jmiranda/SubsurfaceFields/GEM_SubsurfaceFields/config_dataset_full.pkl",
        "v2_src": "/unity/g2/jmiranda/v2-nespreso/src",
        "refit_pca": false,
        "pca_ckpt": "saved/models/NeSPReSO2_ARGO_GoM/argo16_scales/model_best.pth"
    },
    "outputs": {
        "temperature": 16,
        "salinity": 16
    },
    "data_loader": {
        "type": "NeSPReSODataLoader",
        "args": {
            "cache_path": "",
            "batch_size": 512,
            "shuffle": true,
            "split_mode": "chronological",
            "train_frac": 0.7,
            "val_frac": 0.15,
            "test_frac": 0.15,
            "split": "train",
            "num_workers": 0,
            "pin_memory": false
        }
    },
    "optimizer": {
        "type": "AdamW",
        "args": {
            "lr": 0.001,
            "weight_decay": 0.0001,
            "amsgrad": false
        }
    },
    "loss": "combined_pca_loss",
    "loss_config": {
        "mode": "pc_mse_only"
    },
    "metrics": ["profile_rmse"],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 100000,
            "gamma": 1.0
        }
    },
    "trainer": {
        "epochs": 8000,
        "save_dir": "saved/",
        "save_period": 1,
        "log_interval": 10,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 500,
        "tensorboard": true
    },
    "residual_training": {
        "stage": "frozen_base",
        "baseline_verify": true
    }
}
