{
    "name": "NeSPReSO2_ARGO_L3_L4_smoke",
    "n_gpu": 1,
    "seed": 42,

    "arch": {
        "type": "PatchConvMLP",
        "args": {
            "input_dim": 46881,
            "output_dim": 32,
            "dropout_prob": 0.2,
            "d_model": 128,
            "head_layers": [1024, 1024],
            "patch_shape": [15, 5, 25, 25],
            "n_enc": 6,
            "n_sat": 15
        }
    },

    "input_params": {
        "timecos": true,
        "timesin": true,
        "latcos": true,
        "latsin": true,
        "loncos": true,
        "lonsin": true,
        "sss": false,
        "sst": false,
        "ssh": false,
        "sat": false
    },

    "io": {
        "dataset_tag": "argo_v2",
        "cache_dir": "../data/cache",
        "spatial_pad": 12,
        "temporal_pad": 4,
        "v2_pickle": "/unity/g2/jmiranda/SubsurfaceFields/GEM_SubsurfaceFields/config_dataset_full.pkl",
        "v2_src": "/unity/g2/jmiranda/v2-nespreso/src",
        "v2_reload": false,
        "refit_pca": true,
        "l3": {
            "enabled": true,
            "raw_root": "../data/raw",
            "processed_root": "../data/processed",
            "patch_half_deg": 3.0,
            "grid_step_deg": 0.25,
            "time_windows_hours": [0, 24, 72, 168, 336],
            "variables": {
                "ssh": {"product": "ssh_l3_historical", "raw_subdir": "altimetry_l3"},
                "wind_u": {"product": "era5_wind", "component": "u", "raw_subdir": "era5"},
                "wind_v": {"product": "era5_wind", "component": "v", "raw_subdir": "era5"}
            },
            "features": ["value", "mask", "age", "uncertainty", "count"]
        },
        "l4": {
            "enabled": true,
            "mode": "mask_augment",
            "apply_to": ["ssh"],
            "noise_scale": 0.0,
            "mission_dropout_prob": 0.0,
            "time_window_dropout_prob": 0.0
        }
    },

    "outputs": {
        "temperature": 16,
        "salinity": 16
    },

    "loss_scales": {
        "profile_scales": {"temperature": 2.0029, "salinity": 0.0313},
        "combined_pca_scale": 2.0,
        "combined_mse_scale": 0.2174
    },

    "density": {
        "enabled": false,
        "checkpoint": "",
        "stats_path": "",
        "stab_weight": 0.0,
        "smooth_weight": 0.0
    },

    "data_loader": {
        "type": "NeSPReSODataLoader",
        "args": {
            "cache_path": "",
            "batch_size": 32,
            "shuffle": true,
            "split_mode": "chronological",
            "train_frac": 0.7,
            "val_frac": 0.15,
            "test_frac": 0.15,
            "split": "train",
            "num_workers": 0,
            "pin_memory": false
        }
    },

    "optimizer": {
        "type": "Adam",
        "args": {"lr": 0.001, "weight_decay": 0, "amsgrad": false}
    },

    "loss": "combined_pca_loss",
    "metrics": ["profile_rmse"],

    "lr_scheduler": {
        "type": "StepLR",
        "args": {"step_size": 100000, "gamma": 1.0}
    },

    "trainer": {
        "epochs": 2,
        "save_dir": "saved/smoke_argo_l3_l4/",
        "save_period": 2,
        "log_interval": 1,
        "verbosity": 2,
        "monitor": "off",
        "early_stop": 0,
        "tensorboard": false
    }
}
