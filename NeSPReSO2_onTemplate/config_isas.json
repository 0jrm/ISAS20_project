{
    "name": "NeSPReSO2_ISAS_GoM",
    "n_gpu": 1,
    "seed": 42,

    "arch": {
        "type": "PredictionModel",
        "args": {
            "input_dim": 9,
            "layers_config": [512, 512],
            "output_dim": 30,
            "dropout_prob": 0.2
        }
    },

    "input_params": {
        "timecos": true,
        "timesin": true,
        "latcos": true,
        "latsin": true,
        "loncos": true,
        "lonsin": true,
        "sss": true,
        "sst": true,
        "ssh": true,
        "sat": true
    },

    "io": {
        "dataset_tag": "isas20",
        "data_path": "../data/NeSPReSO_v2_GoM_sat",
        "sat_file": "satellite_NeSPReSO_v2_GoM.h5",
        "prof_file": "profiles_NeSPReSO_v2_GoM.h5",
        "spatial_pad": 0,
        "temporal_pad": 0,
        "BBox": null,
        "cache_dir": "../data/cache",
        "groups": {
            "sss": {"h5_group": "sss", "h5_var": "sos"},
            "sst": {"h5_group": "ostia", "h5_var": "analysed_sst"},
            "ssh": {"h5_group": "ssh", "h5_var": "adt"}
        }
    },

    "outputs": {
        "temperature": 15,
        "salinity": 15
    },

    "density": {
        "enabled": false,
        "checkpoint": "",
        "stats_path": "",
        "stab_weight": 0.0,
        "smooth_weight": 0.0
    },

    "data_loader": {
        "type": "NeSPReSODataLoader",
        "args": {
            "cache_path": "",
            "batch_size": 512,
            "shuffle": true,
            "train_frac": 0.7,
            "val_frac": 0.15,
            "test_frac": 0.15,
            "split": "train",
            "num_workers": 0,
            "pin_memory": false
        }
    },

    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": false
        }
    },

    "loss": "combined_pca_loss",
    "metrics": ["profile_rmse"],

    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 100000,
            "gamma": 1.0
        }
    },

    "trainer": {
        "epochs": 8000,
        "save_dir": "saved/",
        "save_period": 1,
        "log_interval": 10,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 500,
        "tensorboard": false
    }
}
